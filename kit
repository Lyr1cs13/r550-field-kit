#!/usr/bin/env bash
set -eo pipefail
export R550_KIT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$R550_KIT_ROOT"
export R550_MAPPING_STATE="$R550_KIT_ROOT/state/mapping"
[[ ! -f state/runtime.env ]] || source state/runtime.env
[[ ! -f state/workspace.env ]] || source state/workspace.env
session_prefix=${R550_SCREEN_PREFIX:-r550}
command=${1:-help}; shift || true
if [[ -f state/workspace.env ]]; then
  case "$command" in
    profile) exec python3 tools/workspace_guard.py "${1:-status}" ;;
    nav|site|mapping|teleop|explore|hold|stop|api|network|setup|servo-probe|c5-config|c5-collector)
      if [[ ${R550_GUARD_PARENT:-} != "$PPID" ]]; then
        exec python3 tools/workspace_guard.py run "$command" "$@"
      fi ;;
  esac
  unset R550_GUARD_PARENT
fi
ros_env() {
  source "$R550_KIT_ROOT/tools/ros_environment.sh"
}
case "$command" in
  setup) exec bash tools/install.sh "$@" ;;
  network) exec python3 tools/network.py "$@" ;;
  scene) exec python3 tools/scene.py "$@" ;;
  preview) exec python3 demo/server.py --backend offline --host 127.0.0.1 --port "${R550_PREVIEW_PORT:-8890}" ;;
  test) exec python3 -m unittest discover -s demo/tests ;;
  postprocess) exec python3 tools/postprocess_heatmap.py "$@" ;;
  doctor) if [[ "${1:-}" != --offline ]]; then ros_env; fi; exec python3 tools/doctor.py "$@" ;;
  site) ros_env; exec bash tools/start_site.sh ;;
  nav)
    ros_env
    [[ -f state/active_scene.json ]] || { echo '先导入并启用新场景：./kit scene new ...；./kit scene use ...'; exit 1; }
    [[ -f vendor_nav2_overlay/vendor_build_verified.json ]] || { echo '先执行 ./kit setup robot 完成控制器构建'; exit 1; }
    exec bash tools/start_nav.sh ;;
  view) ros_env; exec ros2 run rviz2 rviz2 -d "$R550_KIT_ROOT/demo/assets/recharge.rviz" ;;
  teleop) ros_env; exec ros2 run teleop_twist_keyboard teleop_twist_keyboard --ros-args -p speed:=0.10 -p turn:=0.25 ;;
  mapping)
    ros_env; mode=${1:-}; shift || true
    case "$mode" in
      new)
        [[ "${1:-}" == --at-dock ]] || { echo '车尾贴合新桩、车头朝场内后运行：./kit mapping new --at-dock [--auto]'; exit 1; }
        [[ ! -f state/site-mapping/owns-robot ]] || { echo '请先在新场地页面退出建图'; exit 1; }
        if pgrep -f 'wheeltec_robot_node|controller_server|sync_slam_toolbox_node|async_slam_toolbox_node|demo/server[.]py.*--backend[ =]+ros([[:space:]]|$)' >/dev/null; then echo '先执行 ./kit stop'; exit 1; fi
        python3 tools/mapping_state.py
        automatic=false; [[ "${2:-}" != --auto ]] || automatic=true
        mkdir -p state/logs
        screen -dmS "${session_prefix}_mapping" bash -c 'exec ros2 launch "$1/rrt_mapping/mapping.launch.py" automatic:="$2" > "$1/state/logs/mapping.log" 2>&1' _ "$R550_KIT_ROOT" "$automatic"
        echo '建图已启动；在电脑上运行 ./kit view。自动模式选四角、第五点后执行 ./kit explore resume。' ;;
      resume)
        [[ -n "${1:-}" ]] || { echo './kit mapping resume maps/checkpoint_xxx'; exit 1; }
        [[ ! -f state/site-mapping/owns-robot ]] || { echo '请先在新场地页面退出建图'; exit 1; }
        if pgrep -f 'wheeltec_robot_node|controller_server|sync_slam_toolbox_node|async_slam_toolbox_node|demo/server[.]py.*--backend[ =]+ros([[:space:]]|$)' >/dev/null; then echo '先执行 ./kit stop'; exit 1; fi
        checkpoint=$(realpath "$1");mkdir -p state/logs
        [[ -f "$checkpoint/manifest.json" ]] || { echo '缺少检查点 manifest.json'; exit 1; }
        mkdir -p state/mapping
        for f in dock_start.json threshold_avoid.json threshold_keepout.yaml threshold_keepout.pgm; do [[ ! -f "$checkpoint/$f" ]] || cp "$checkpoint/$f" state/mapping/; done
        screen -dmS "${session_prefix}_mapping" bash -c 'exec ros2 launch "$1/rrt_mapping/mapping.launch.py" automatic:=true checkpoint:="$2" > "$1/state/logs/mapping.log" 2>&1' _ "$R550_KIT_ROOT" "$checkpoint"
        echo '已恢复检查点，默认暂停。核对红点与墙线后重新选四角和第五点，再继续探索。' ;;
      save) exec python3 rrt_mapping/session_checkpoint.py save "$@" ;;
      pause) exec python3 rrt_mapping/session_checkpoint.py pause ;;
      continue) exec python3 tools/slam.py write ;;
      avoid) exec python3 tools/mapping_avoid.py "$@" ;;
      *) echo './kit mapping new --at-dock [--auto] | resume CHECKPOINT | save [--output DIR] | pause'; exit 2 ;;
    esac ;;
  explore) ros_env; exec python3 tools/slam.py "$@" ;;
  hold) ros_env; python3 tools/control.py stop 2>/dev/null || true; exec python3 tools/hold.py ;;
  api) exec python3 tools/control.py "$@" ;;
  servo-probe) exec python3 tools/servo_car_probe.py "$@" ;;
  c5-collector) exec python3 tools/c5_collector.py "$@" ;;
  c5-config) exec python3 tools/c5_config.py "$@" ;;
  stop)
    ros_env
    python3 tools/control.py stop 2>/dev/null || true
    python3 tools/hold.py
    for suffix in nav ui mapping motion_gate scan_filter; do screen -S "${session_prefix}_$suffix" -p 0 -X stuff $'\003' 2>/dev/null || true; done
    echo '已请求停车并关闭本工程会话。' ;;
  *) printf '%s\n' './kit setup robot|viewer' './kit network --interface NIC --peer IP [--domain 20]' './kit doctor | preview | view | teleop' './kit mapping new --at-dock [--auto] | resume CHECKPOINT | save' './kit explore pause|resume|return' './kit scene new|use|dock|keepout|survey|list' './kit site | nav | api status|initial_dock|confirm|return' './kit servo-probe [--device PORT]' './kit c5-collector --help | c5-config URL' './kit hold | stop | test' ;;
esac
